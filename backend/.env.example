# Backend Environment Variables

# Frontend URL for CORS (where your Next.js app is hosted)
FRONTEND_URL=http://localhost:3000

# Server Port
PORT=3001

# Database URL (when you set up PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/paxx

# Encryption Key (CRITICAL - use a strong random key in production)
# Generate with: openssl rand -base64 32
# ENCRYPTION_KEY=your-very-secure-encryption-key-here

# JWT Secret (for authentication tokens)
# JWT_SECRET=your-jwt-secret-here

# Node Environment
NODE_ENV=development
